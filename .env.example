# ForgeFlow — environment reference (authoritative).
# Copy to `.env` and fill in. NEVER commit `.env`. Every variable here is read
# through the layered config resolver (backend/app/core/config.py):
#   precedence = admin panel (DB, phase-51) > env (this file) > code default.
# Values left blank fall back to the code default in `Settings`.

# ------------------------------------------------------------------ Core
FORGEFLOW_ENV=local
SECRET_KEY=dev-insecure-change-me
# Credential-vault encryption key (phase-34). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: rotating this key permanently invalidates every stored credential — ciphertext written
# under the old key cannot be decrypted and every token must be re-entered. Back it up.
FERNET_KEY=
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://localhost              # comma-separated; "*" allowed in dev
LOG_LEVEL=INFO
LOG_JSON=true

# ------------------------------------------------------------------ Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=                           # optional; blank = SDK default (admin-editable via phase-51/52)
MODEL_CODEGEN=claude-sonnet-5
MODEL_ROUTING=claude-haiku-4-5-20251001
BUDGET_CAP_INR_PER_PROJECT=                   # blank = uncapped (phase-20)
BUDGET_CAP_INR_GLOBAL=                        # blank = uncapped (phase-20)
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
ANTHROPIC_MAX_TOOL_TURNS=16                    # safety bound on the tool-use loop
ANTHROPIC_MAX_RETRIES=4                        # transient (429/5xx/network) backoff attempts
MODEL_PRICING_JSON=                            # {"<model>": {"input": ₹/Mtok, "output": ₹/Mtok}}; blank = defaults
APP_SKELETON_DIR=templates/app-skeleton        # prebuilt generated-app scaffold (phase-22); copied by instantiate_skeleton
TOOL_OUTPUT_MAX_CHARS=8000                     # cap on command output fed back to the model

# ------------------------------------------------------------------ MongoDB (control plane + shared app-data cluster)
MONGODB_URI=mongodb://localhost:27017
FORGEFLOW_META_DB=forgeflow_meta
# Cluster hosting generated apps' per-project databases in platform mode (phase-36). Blank → reuse
# MONGODB_URI (local dev). A per-project DB name is appended, so give a cluster base URI (no db path).
# Users may instead supply their own MONGODB_URI via the credential vault (BYO); that is never managed.
APP_DB_CLUSTER_URI=

# ------------------------------------------------------------------ Artifacts & blobs (phase-07)
BLOB_BACKEND=gridfs                            # gridfs (default, in-Mongo) | filesystem
BLOB_FS_DIR=                                   # filesystem-backend root dir (required if BLOB_BACKEND=filesystem)
ARTIFACT_INLINE_MAX_BYTES=16384               # artifact payloads <= this stay inline; larger go to the blob store

# ------------------------------------------------------------------ Sandbox (phase 10/11)
SANDBOX_IMAGE=forgeflow-sandbox:latest
SANDBOX_CPU_LIMIT=1.0                          # cores
SANDBOX_MEM_LIMIT=1g
SANDBOX_PIDS_LIMIT=256
SANDBOX_IDLE_TIMEOUT_S=900
SANDBOX_READ_ONLY_ROOT=true                    # read-only root FS; /workspace + /tmp stay writable
SANDBOX_REAP_INTERVAL_S=60                      # idle-reaper sweep interval (seconds)
WORKSPACE_MAX_FILE_BYTES=1048576               # per-file read/write cap for the FS API (phase-12)
SANDBOX_EXEC_TIMEOUT_S=600                     # per-command wall clock before the process is killed
SANDBOX_MAX_CONCURRENT_EXECS=3                 # concurrent commands per project
SANDBOX_SHELL=/bin/bash                        # interactive terminal shell inside the sandbox

# ------------------------------------------------------------------ Live preview (phase 15)
PREVIEW_FE_DIR=frontend                        # skeleton layout (phase-22)
PREVIEW_BE_DIR=backend
PREVIEW_FE_CMD=pnpm dev --host 0.0.0.0 --port {port}
PREVIEW_BE_CMD=pnpm dev                        # port injected via the PORT env var
PREVIEW_FE_PORT=5173
PREVIEW_BE_PORT=3001
PREVIEW_HEALTH_TIMEOUT_S=90
PREVIEW_NETWORK_NAME=forgeflow-preview         # dedicated INTERNAL network: no host, no internet
EGRESS_NETWORK_NAME=forgeflow-egress           # ROUTED net, joined only during a live run (phase-39)
PREVIEW_BASE_DOMAIN=                           # prod wildcard domain; empty -> *.preview.localhost

# ------------------------------------------------------------------ Design providers (phase 17/18)
# Stitch (default) — see plans/phase-17-stitch-provider.md. Blank creds → provider health()=down
# and the design stage falls back (fake/figma) instead of crashing.
STITCH_GCP_PROJECT=
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_QUOTA_MONTHLY=350                        # generations/window (monthly free tier ~350)
STITCH_MCP_URL=                                 # Stitch MCP server base URL
STITCH_TOKEN_URL=                               # OAuth2 token endpoint (client-credentials grant)
STITCH_SCOPE=                                   # optional OAuth scope
STITCH_TIMEOUT_S=60                             # per-call wall clock
STITCH_MAX_RETRIES=2                            # extra attempts on transient errors
STITCH_TOKEN_SKEW_S=60                          # refresh this many seconds before real expiry
STITCH_QUOTA_SOFT_RATIO=0.9                     # used/limit >= this → health() degraded
# Figma (alternative) — see plans/phase-18-figma-provider.md. Blank token → health()=down.
FIGMA_TOKEN=                                    # static Figma access token (no OAuth refresh)
FIGMA_MCP_URL=                                  # Figma MCP server base URL
FIGMA_TIMEOUT_S=60                              # per-call wall clock
FIGMA_MAX_RETRIES=2                             # extra attempts on transient errors
DESIGN_PROVIDER=stitch                         # active provider: stitch | figma | fake
DESIGN_MAX_IMAGES=8                             # max screenshots per design intake (phase-19)
DESIGN_MAX_IMAGE_BYTES=5242880                  # per-screenshot size cap (5 MiB)

# ------------------------------------------------------------------ Deploy providers (platform-owned defaults; BYO stored per-user, phase 34/35)
VERCEL_TOKEN=                                   # frontend (SPA) target — never the backend
RENDER_API_KEY=                                 # backend (persistent Node service) target
DEPLOY_DEFAULT_MODE=seamless                   # seamless | byo
VERCEL_API_URL=https://api.vercel.com
RENDER_API_URL=https://api.render.com
DEPLOY_TIMEOUT_S=60                             # per-call wall clock
DEPLOY_MAX_RETRIES=2                            # extra attempts on transient errors
DEPLOY_REPO_URL=                               # git repo Render builds the backend from (phase-37; blank locally)
DEPLOY_REGION=                                 # optional provider region for the backend service
DEPLOY_HEALTH_TIMEOUT_S=180                    # how long to poll a deploy until it goes live

# ------------------------------------------------------- Live validation (phase 39)
LIVE_TEST_SELECTION=both                       # smoke | critical | both | all (untagged suites run in full)
LIVE_TEST_TIMEOUT_S=600                        # wall clock for the live Playwright invocation
LIVE_WARMUP_ATTEMPTS=10                        # probe the deployed URL until it wakes (free tiers sleep)
LIVE_WARMUP_INTERVAL_S=6.0
LIVE_TEST_RETRIES=1                            # Playwright retry for a flaky first hit over the network

# ------------------------------------------------------------------ Realtime (phase 05)
REALTIME_RING_SIZE=256
REALTIME_HEARTBEAT_S=20.0

# ------------------------------------------------------------------ Repair loop (phase 29-31)
REPAIR_MAX_ITERATIONS=5
REPAIR_STALL_THRESHOLD=2

# ------------------------------------------------------------------ Frontend (Vite) — consumed by frontend/, prefix VITE_
VITE_API_BASE_URL=http://localhost:8000
