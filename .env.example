# ForgeFlow — environment reference (authoritative).
# Copy to `.env` and fill in. NEVER commit `.env`. Every variable here is read
# through the layered config resolver (backend/app/core/config.py):
#   precedence = admin panel (DB, phase-51) > env (this file) > code default.
# Values left blank fall back to the code default in `Settings`.
#
# EVERY key below is also editable at runtime from the admin dashboard (/admin), which stores an
# override that wins over this file — no redeploy. Secrets set there are encrypted at rest and never
# readable again. Three keys are the exception and MUST come from here, because they are read before
# the admin layer exists (MONGODB_URI, FORGEFLOW_META_DB) or protect the stored secrets themselves
# (FERNET_KEY); the dashboard shows them read-only with that reason.
#
# IMPORTANT: comments live on their OWN lines, never trailing a `KEY=value`. This keeps the file
# safe to `cp .env.example .env` for BOTH consumers: pydantic-settings (python-dotenv, strips inline
# comments) AND docker-compose's `env_file` (which keeps an inline `# comment` after a *blank* value
# as the literal value — that is what broke `make dev`). Keep any new key in this same style.

# ------------------------------------------------------------------ Core
FORGEFLOW_ENV=local
SECRET_KEY=dev-insecure-change-me
# Credential-vault encryption key (phase-34). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: rotating this key permanently invalidates every stored credential — ciphertext written
# under the old key cannot be decrypted and every token must be re-entered. Back it up.
FERNET_KEY=
APP_VERSION=0.1.0
# comma-separated; "*" allowed in dev
CORS_ORIGINS=http://localhost:5173,http://localhost
LOG_LEVEL=INFO
LOG_JSON=true

# Hero-demo account seeded by `make demo-seed` (phase-50). The password is blank on purpose — the
# script refuses to seed without one (a shipped default credential is a security risk); set it for
# a rehearsal.
DEMO_EMAIL=demo@forgeflow.dev
DEMO_PASSWORD=

# Optional dev admin for the /admin dashboard (phase-52). When BOTH are set, `make seed` creates or
# promotes this user to admin. Leave blank to skip.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ------------------------------------------------------------------ Auth & limits (phase 03/47)
# access-token signing algorithm: HS256 | HS384 | HS512
JWT_ALGORITHM=HS256
# access-token lifetime
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# per-IP requests/minute on /auth/login + /auth/register
AUTH_RATE_LIMIT_PER_MINUTE=30
# per-USER requests/minute on endpoints that cost money or capacity; 0 disables
EXPENSIVE_RATE_LIMIT_PER_MINUTE=20
# hard backstop on any single request body (64 MiB); must exceed a full design-image batch
MAX_REQUEST_BYTES=67108864

# ------------------------------------------------------------------ Anthropic
ANTHROPIC_API_KEY=
# optional; blank = SDK default (admin-editable via phase-51/52)
ANTHROPIC_BASE_URL=
MODEL_CODEGEN=claude-sonnet-5
MODEL_ROUTING=claude-haiku-4-5-20251001
# blank = uncapped (phase-20)
BUDGET_CAP_INR_PER_PROJECT=
# blank = uncapped (phase-20)
BUDGET_CAP_INR_GLOBAL=
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
# safety bound on the tool-use loop — one turn per tool call, so a full-stack build needs hundreds
ANTHROPIC_MAX_TOOL_TURNS=250
# transient (429/5xx/network) backoff attempts
ANTHROPIC_MAX_RETRIES=4
# {"<model>": {"input": Rs/Mtok, "output": Rs/Mtok}}; blank = defaults
MODEL_PRICING_JSON=
# prebuilt generated-app scaffold (phase-22); copied by instantiate_skeleton
APP_SKELETON_DIR=templates/app-skeleton
# cap on command output fed back to the model
TOOL_OUTPUT_MAX_CHARS=8000
# per-artifact cap on design/requirements context handed to the codegen agent (phase-23)
CODEGEN_CONTEXT_CHAR_BUDGET=6000

# ------------------------------------------------------- LLM provider (phase 53)
# Which chat backend the agents use: "anthropic" (default, Claude Messages API) or "openai" (any
# OpenAI-compatible Chat Completions endpoint). When "openai", set MODEL_CODEGEN / MODEL_ROUTING
# (above) to that provider's model ids and price them via MODEL_PRICING_JSON.
LLM_PROVIDER=anthropic
OPENAI_API_KEY=
# blank -> OpenAI default (https://api.openai.com/v1). Examples of compatible endpoints:
#   http://localhost:11434/v1 (Ollama) · https://openrouter.ai/api/v1 · https://api.groq.com/openai/v1
#   https://api.mistral.ai/v1 (Mistral — use a tool-calling model, e.g. MODEL_CODEGEN=devstral-latest
#     or mistral-large-latest; its API rejects the token-usage stream option, which the transport
#     detects once and drops, so cost accounting reports 0 tokens for it)
OPENAI_BASE_URL=
# transient (429/5xx/network) backoff attempts
OPENAI_MAX_RETRIES=4

# phase-57 — endpoints disagree about the request schema (a reasoning-family model rejects
# `max_tokens` and wants `max_completion_tokens`; Mistral rejects `stream_options`). The transport
# reads the provider's own 400, repairs the body, retries, and remembers the working shape in
# LLM_PARAM_QUIRKS, keyed by "<endpoint>|<model>". Learned automatically; safe to clear.
LLM_PARAM_QUIRKS=
# per-call cap on request repairs (counted separately from OPENAI_MAX_RETRIES)
OPENAI_MAX_PARAM_REPAIRS=4
# false -> use only the built-in seed rules; never learn or persist a repair
OPENAI_PARAM_LEARNING=true

# ------------------------------------------------------------------ MongoDB (control plane + shared app-data cluster)
MONGODB_URI=mongodb://localhost:27017
FORGEFLOW_META_DB=forgeflow_meta
# Cluster hosting generated apps' per-project databases in platform mode (phase-36). Blank -> reuse
# MONGODB_URI (local dev). A per-project DB name is appended, so give a cluster base URI (no db path).
# Users may instead supply their own MONGODB_URI via the credential vault (BYO); that is never managed.
APP_DB_CLUSTER_URI=
# The SAME cluster as above, addressed the way a *sandbox* must address it. A sandbox runs on an
# internal docker network: `localhost` there is the sandbox itself and there is no route to this
# machine, so a loopback URI makes the generated app's queries time out ("buffering timed out after
# 10000ms") even though its backend booted fine. Blank -> inject APP_DB_CLUSTER_URI unchanged, which
# is correct when the control plane also runs in docker (`make dev` sets both to the appdb service).
# Running the API on the host? Then set APP_DB_CLUSTER_URI=mongodb://localhost:27018 (the published
# port) and APP_DB_SANDBOX_URI=mongodb://forgeflow-appdb:27017 (the name sandboxes resolve).
APP_DB_SANDBOX_URI=

# ------------------------------------------------------------------ Artifacts & blobs (phase-07)
# gridfs (default, in-Mongo) | filesystem
BLOB_BACKEND=gridfs
# filesystem-backend root dir (required if BLOB_BACKEND=filesystem)
BLOB_FS_DIR=
# artifact payloads <= this stay inline; larger go to the blob store
ARTIFACT_INLINE_MAX_BYTES=16384

# ------------------------------------------------------------------ Sandbox (phase 10/11)
SANDBOX_IMAGE=forgeflow-sandbox:latest
# cores
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEM_LIMIT=1g
SANDBOX_PIDS_LIMIT=256
SANDBOX_IDLE_TIMEOUT_S=900
# read-only root FS; /workspace, /home/app (package-manager caches) + /tmp stay writable
SANDBOX_READ_ONLY_ROOT=true
# let a dependency-install command borrow the routed egress network for its duration; off → the
# sandbox can never reach the npm registry and only pre-installed dependencies work
SANDBOX_INSTALL_NETWORK=true
# wall clock for a dependency install (a cold pnpm install is minutes, not seconds)
SANDBOX_INSTALL_TIMEOUT_S=1800
# idle-reaper sweep interval (seconds)
SANDBOX_REAP_INTERVAL_S=60
# per-file read/write cap for the FS API (phase-12)
WORKSPACE_MAX_FILE_BYTES=1048576
# per-command wall clock before the process is killed
SANDBOX_EXEC_TIMEOUT_S=600
# concurrent commands per project
SANDBOX_MAX_CONCURRENT_EXECS=3
# interactive terminal shell inside the sandbox
SANDBOX_SHELL=/bin/bash

# ------------------------------------------------------------------ Live preview (phase 15)
# skeleton layout (phase-22)
PREVIEW_FE_DIR=frontend
PREVIEW_BE_DIR=backend
# Quoted because the value contains spaces: uv's dotenv parser (used by `make seed`/`demo-*` via
# --env-file) rejects unquoted spaces and would drop every var after this line. python-dotenv and
# docker-compose both strip the surrounding quotes, so the effective value is unchanged.
PREVIEW_FE_CMD="pnpm dev --host 0.0.0.0 --port {port}"
# port injected via the PORT env var
PREVIEW_BE_CMD="pnpm dev"
PREVIEW_FE_PORT=5173
PREVIEW_BE_PORT=3001
PREVIEW_HEALTH_TIMEOUT_S=90
# frontend probe path; the backend probe uses the skeleton's /health contract
PREVIEW_HEALTH_PATH=/
PREVIEW_BE_HEALTH_PATH=/health
# dedicated INTERNAL network: no host, no internet
PREVIEW_NETWORK_NAME=forgeflow-preview
# ROUTED net, joined only during a live run (phase-39)
EGRESS_NETWORK_NAME=forgeflow-egress
# prod wildcard domain; empty -> *.preview.localhost
PREVIEW_BASE_DOMAIN=
# recent output lines each preview process keeps as boot-failure evidence (phase-55)
PREVIEW_LOG_TAIL_LINES=200

# ------------------------------------------------------------------ Design providers (phase 17/18)
# Stitch (default) — Google Labs' AI UI designer, reached over its MCP API. See
# plans/phase-17-stitch-provider.md. Blank creds -> provider health()=down and the design stage
# falls back (figma/fake) instead of crashing.
#
# EASIEST PATH: create a key at https://stitch.withgoogle.com -> profile menu -> Stitch settings ->
# API keys -> Create API key, and set STITCH_API_KEY. Nothing else below is required.
STITCH_API_KEY=
# Alternative to the key: a Google access token (expires in ~1h, not refreshed here). Get one with
#   gcloud beta services mcp enable stitch.googleapis.com
#   gcloud auth application-default print-access-token
STITCH_ACCESS_TOKEN=
# Optional: Cloud project charged/quota-attributed for the calls (sent as X-Goog-User-Project).
STITCH_GCP_PROJECT=
# Stitch MCP endpoint (JSON-RPC over HTTP). Only change this to point at a proxy.
STITCH_MCP_URL=https://stitch.googleapis.com/mcp
# Optional: generate into an existing Stitch project instead of one created on first use.
STITCH_PROJECT_ID=
# Optional: GEMINI_3_FLASH (standard quota) | GEMINI_3_PRO (experimental, far smaller quota).
STITCH_MODEL_ID=
# Generation is async — how long to keep re-reading a new screen for its HTML before falling back.
STITCH_READY_TIMEOUT_S=90
# generations/window (standard free tier ~350/month; experimental models get far fewer)
STITCH_QUOTA_MONTHLY=350
# Only for a self-hosted/partner proxy that implements the OAuth2 client-credentials grant.
# Google's own token endpoint does NOT — leave these blank when talking to stitch.googleapis.com.
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_TOKEN_URL=
STITCH_SCOPE=
# per-call wall clock for the handshake and metadata reads
STITCH_TIMEOUT_S=60
# Per-call wall clock for generate/edit, which are far slower than a read: a multi-screen prompt
# measured ~76s against the live API, so the 60s read budget cut the connection *after* Stitch had
# generated (and charged for) the screens, which surfaced as a fallback to the fake provider.
STITCH_GENERATE_TIMEOUT_S=300
# extra attempts on transient errors (metadata reads only — a generation is never repeated,
# because Stitch has usually already produced the screens and a retry spends a second generation)
STITCH_MAX_RETRIES=2
# refresh this many seconds before real expiry
STITCH_TOKEN_SKEW_S=60
# used/limit >= this -> health() degraded
STITCH_QUOTA_SOFT_RATIO=0.9
# Figma (alternative) — see plans/phase-18-figma-provider.md. Blank token -> health()=down.
# static Figma access token (no OAuth refresh)
FIGMA_TOKEN=
# Figma MCP server base URL
FIGMA_MCP_URL=
# per-call wall clock
FIGMA_TIMEOUT_S=60
# extra attempts on transient errors
FIGMA_MAX_RETRIES=2
# active provider: stitch | figma | fake
DESIGN_PROVIDER=stitch
# auto-fallback order on a recoverable failure (phase-48); "" disables
DESIGN_FALLBACK_CHAIN=figma,fake
# max screenshots per design intake (phase-19)
DESIGN_MAX_IMAGES=8
# per-screenshot size cap (5 MiB)
DESIGN_MAX_IMAGE_BYTES=5242880

# ------------------------------------------------------------------ Deploy providers (platform-owned defaults; BYO stored per-user, phase 34/35)
# frontend (SPA) target — never the backend
VERCEL_TOKEN=
# backend (persistent Node service) target
RENDER_API_KEY=
# seamless | byo
DEPLOY_DEFAULT_MODE=seamless
VERCEL_API_URL=https://api.vercel.com
RENDER_API_URL=https://api.render.com
# per-call wall clock
DEPLOY_TIMEOUT_S=60
# extra attempts on transient errors
DEPLOY_MAX_RETRIES=2
# git repo Render builds the backend from (phase-37; blank locally)
DEPLOY_REPO_URL=
# optional provider region for the backend service
DEPLOY_REGION=
# how long to poll a deploy until it goes live
DEPLOY_HEALTH_TIMEOUT_S=180
# infra analyzer (phase-33): how far it walks a workspace looking for env references
INFRA_SCAN_MAX_FILES=200
INFRA_SCAN_MAX_DEPTH=6

# ------------------------------------------------------- Test runner (phase 28)
# wall clock for one suite invocation inside the sandbox (Playwright can be slow)
TEST_RUNNER_TIMEOUT_S=900

# ------------------------------------------------------- Live validation (phase 39)
# smoke | critical | both | all (untagged suites run in full)
LIVE_TEST_SELECTION=both
# wall clock for the live Playwright invocation
LIVE_TEST_TIMEOUT_S=600
# probe the deployed URL until it wakes (free tiers sleep)
LIVE_WARMUP_ATTEMPTS=10
LIVE_WARMUP_INTERVAL_S=6.0
# Playwright retry for a flaky first hit over the network
LIVE_TEST_RETRIES=1
# OUTER bound (phase-40): repair->redeploy->re-validate cycles
VALIDATE_MAX_CYCLES=2

# ------------------------------------------------------- Observability (phase 46)
# warn at this fraction of a cap; 0 disables the warning
BUDGET_WARN_RATIO=0.8

# ------------------------------------------------------------------ Realtime (phase 05)
REALTIME_RING_SIZE=256
REALTIME_HEARTBEAT_S=20.0

# ------------------------------------------------------------------ Repair loop (phase 29-31)
REPAIR_MAX_ITERATIONS=5
REPAIR_STALL_THRESHOLD=2
# escalate once patches have broken previously-passing tests this many times (phase-55)
REPAIR_MAX_REGRESSIONS=2
# minimal-context budget (phase-29): never feed the whole repo when a diff suffices
REPAIR_CONTEXT_MAX_CHARS=24000
REPAIR_CONTEXT_MAX_FILE_CHARS=8000
REPAIR_CONTEXT_DIFF_MAX_CHARS=8000

# ------------------------------------------------------------------ Build verification & self-heal (phase-55)
# after codegen: install -> typecheck -> boot -> placeholder check, then self-heal code failures
# through the existing bounded repair loop (env failures short-circuit with zero iterations)
BUILD_INTEGRATION_MAX_ITERATIONS=3
BUILD_MAX_WALL_CLOCK_S=3600
BUILD_TYPECHECK_CMD="pnpm typecheck"
BUILD_TYPECHECK_TIMEOUT_S=600
BUILD_TYPECHECK_MAX_FAILURES=20

# phase-56 — the build is planned into phases and implemented one at a time, each with its own
# small context, typecheck gate and commit. These bound plan size and per-phase model work.
BUILD_MAX_PHASES=8
BUILD_PHASE_MAX_TOOL_TURNS=60
BUILD_PHASE_MAX_FIX_ATTEMPTS=2
BUILD_PLAN_DIR="phase-plan"
BUILD_PLAN_IN_WORKSPACE=true

# ------------------------------------------------------------------ Frontend (Vite) — consumed by frontend/, prefix VITE_
VITE_API_BASE_URL=http://localhost:8000
