# ForgeFlow — environment reference (authoritative).
# Copy to `.env` and fill in. NEVER commit `.env`. Every variable here is read
# through the layered config resolver (backend/app/core/config.py):
#   precedence = admin panel (DB, phase-51) > env (this file) > code default.
# Values left blank fall back to the code default in `Settings`.
#
# IMPORTANT: comments live on their OWN lines, never trailing a `KEY=value`. This keeps the file
# safe to `cp .env.example .env` for BOTH consumers: pydantic-settings (python-dotenv, strips inline
# comments) AND docker-compose's `env_file` (which keeps an inline `# comment` after a *blank* value
# as the literal value — that is what broke `make dev`). Keep any new key in this same style.

# ------------------------------------------------------------------ Core
FORGEFLOW_ENV=local
SECRET_KEY=dev-insecure-change-me
# Credential-vault encryption key (phase-34). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: rotating this key permanently invalidates every stored credential — ciphertext written
# under the old key cannot be decrypted and every token must be re-entered. Back it up.
FERNET_KEY=
APP_VERSION=0.1.0
# comma-separated; "*" allowed in dev
CORS_ORIGINS=http://localhost:5173,http://localhost
LOG_LEVEL=INFO
LOG_JSON=true

# Hero-demo account seeded by `make demo-seed` (phase-50). The password is blank on purpose — the
# script refuses to seed without one (a shipped default credential is a security risk); set it for
# a rehearsal.
DEMO_EMAIL=demo@forgeflow.dev
DEMO_PASSWORD=

# Optional dev admin for the /admin dashboard (phase-52). When BOTH are set, `make seed` creates or
# promotes this user to admin. Leave blank to skip.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ------------------------------------------------------------------ Anthropic
ANTHROPIC_API_KEY=
# optional; blank = SDK default (admin-editable via phase-51/52)
ANTHROPIC_BASE_URL=
MODEL_CODEGEN=claude-sonnet-5
MODEL_ROUTING=claude-haiku-4-5-20251001
# blank = uncapped (phase-20)
BUDGET_CAP_INR_PER_PROJECT=
# blank = uncapped (phase-20)
BUDGET_CAP_INR_GLOBAL=
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
# safety bound on the tool-use loop
ANTHROPIC_MAX_TOOL_TURNS=16
# transient (429/5xx/network) backoff attempts
ANTHROPIC_MAX_RETRIES=4
# {"<model>": {"input": Rs/Mtok, "output": Rs/Mtok}}; blank = defaults
MODEL_PRICING_JSON=
# prebuilt generated-app scaffold (phase-22); copied by instantiate_skeleton
APP_SKELETON_DIR=templates/app-skeleton
# cap on command output fed back to the model
TOOL_OUTPUT_MAX_CHARS=8000

# ------------------------------------------------------- LLM provider (phase 53)
# Which chat backend the agents use: "anthropic" (default, Claude Messages API) or "openai" (any
# OpenAI-compatible Chat Completions endpoint). When "openai", set MODEL_CODEGEN / MODEL_ROUTING
# (above) to that provider's model ids and price them via MODEL_PRICING_JSON.
LLM_PROVIDER=anthropic
OPENAI_API_KEY=
# blank -> OpenAI default (https://api.openai.com/v1). Examples of compatible endpoints:
#   http://localhost:11434/v1 (Ollama) · https://openrouter.ai/api/v1 · https://api.groq.com/openai/v1
OPENAI_BASE_URL=
# transient (429/5xx/network) backoff attempts
OPENAI_MAX_RETRIES=4

# ------------------------------------------------------------------ MongoDB (control plane + shared app-data cluster)
MONGODB_URI=mongodb://localhost:27017
FORGEFLOW_META_DB=forgeflow_meta
# Cluster hosting generated apps' per-project databases in platform mode (phase-36). Blank -> reuse
# MONGODB_URI (local dev). A per-project DB name is appended, so give a cluster base URI (no db path).
# Users may instead supply their own MONGODB_URI via the credential vault (BYO); that is never managed.
APP_DB_CLUSTER_URI=

# ------------------------------------------------------------------ Artifacts & blobs (phase-07)
# gridfs (default, in-Mongo) | filesystem
BLOB_BACKEND=gridfs
# filesystem-backend root dir (required if BLOB_BACKEND=filesystem)
BLOB_FS_DIR=
# artifact payloads <= this stay inline; larger go to the blob store
ARTIFACT_INLINE_MAX_BYTES=16384

# ------------------------------------------------------------------ Sandbox (phase 10/11)
SANDBOX_IMAGE=forgeflow-sandbox:latest
# cores
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEM_LIMIT=1g
SANDBOX_PIDS_LIMIT=256
SANDBOX_IDLE_TIMEOUT_S=900
# read-only root FS; /workspace + /tmp stay writable
SANDBOX_READ_ONLY_ROOT=true
# idle-reaper sweep interval (seconds)
SANDBOX_REAP_INTERVAL_S=60
# per-file read/write cap for the FS API (phase-12)
WORKSPACE_MAX_FILE_BYTES=1048576
# per-command wall clock before the process is killed
SANDBOX_EXEC_TIMEOUT_S=600
# concurrent commands per project
SANDBOX_MAX_CONCURRENT_EXECS=3
# interactive terminal shell inside the sandbox
SANDBOX_SHELL=/bin/bash

# ------------------------------------------------------------------ Live preview (phase 15)
# skeleton layout (phase-22)
PREVIEW_FE_DIR=frontend
PREVIEW_BE_DIR=backend
PREVIEW_FE_CMD=pnpm dev --host 0.0.0.0 --port {port}
# port injected via the PORT env var
PREVIEW_BE_CMD=pnpm dev
PREVIEW_FE_PORT=5173
PREVIEW_BE_PORT=3001
PREVIEW_HEALTH_TIMEOUT_S=90
# dedicated INTERNAL network: no host, no internet
PREVIEW_NETWORK_NAME=forgeflow-preview
# ROUTED net, joined only during a live run (phase-39)
EGRESS_NETWORK_NAME=forgeflow-egress
# prod wildcard domain; empty -> *.preview.localhost
PREVIEW_BASE_DOMAIN=

# ------------------------------------------------------------------ Design providers (phase 17/18)
# Stitch (default) — see plans/phase-17-stitch-provider.md. Blank creds -> provider health()=down
# and the design stage falls back (fake/figma) instead of crashing.
STITCH_GCP_PROJECT=
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
# generations/window (monthly free tier ~350)
STITCH_QUOTA_MONTHLY=350
# Stitch MCP server base URL
STITCH_MCP_URL=
# OAuth2 token endpoint (client-credentials grant)
STITCH_TOKEN_URL=
# optional OAuth scope
STITCH_SCOPE=
# per-call wall clock
STITCH_TIMEOUT_S=60
# extra attempts on transient errors
STITCH_MAX_RETRIES=2
# refresh this many seconds before real expiry
STITCH_TOKEN_SKEW_S=60
# used/limit >= this -> health() degraded
STITCH_QUOTA_SOFT_RATIO=0.9
# Figma (alternative) — see plans/phase-18-figma-provider.md. Blank token -> health()=down.
# static Figma access token (no OAuth refresh)
FIGMA_TOKEN=
# Figma MCP server base URL
FIGMA_MCP_URL=
# per-call wall clock
FIGMA_TIMEOUT_S=60
# extra attempts on transient errors
FIGMA_MAX_RETRIES=2
# active provider: stitch | figma | fake
DESIGN_PROVIDER=stitch
# auto-fallback order on a recoverable failure (phase-48); "" disables
DESIGN_FALLBACK_CHAIN=figma,fake
# max screenshots per design intake (phase-19)
DESIGN_MAX_IMAGES=8
# per-screenshot size cap (5 MiB)
DESIGN_MAX_IMAGE_BYTES=5242880

# ------------------------------------------------------------------ Deploy providers (platform-owned defaults; BYO stored per-user, phase 34/35)
# frontend (SPA) target — never the backend
VERCEL_TOKEN=
# backend (persistent Node service) target
RENDER_API_KEY=
# seamless | byo
DEPLOY_DEFAULT_MODE=seamless
VERCEL_API_URL=https://api.vercel.com
RENDER_API_URL=https://api.render.com
# per-call wall clock
DEPLOY_TIMEOUT_S=60
# extra attempts on transient errors
DEPLOY_MAX_RETRIES=2
# git repo Render builds the backend from (phase-37; blank locally)
DEPLOY_REPO_URL=
# optional provider region for the backend service
DEPLOY_REGION=
# how long to poll a deploy until it goes live
DEPLOY_HEALTH_TIMEOUT_S=180

# ------------------------------------------------------- Live validation (phase 39)
# smoke | critical | both | all (untagged suites run in full)
LIVE_TEST_SELECTION=both
# wall clock for the live Playwright invocation
LIVE_TEST_TIMEOUT_S=600
# probe the deployed URL until it wakes (free tiers sleep)
LIVE_WARMUP_ATTEMPTS=10
LIVE_WARMUP_INTERVAL_S=6.0
# Playwright retry for a flaky first hit over the network
LIVE_TEST_RETRIES=1
# OUTER bound (phase-40): repair->redeploy->re-validate cycles
VALIDATE_MAX_CYCLES=2

# ------------------------------------------------------- Observability (phase 46)
# warn at this fraction of a cap; 0 disables the warning
BUDGET_WARN_RATIO=0.8

# ------------------------------------------------------------------ Realtime (phase 05)
REALTIME_RING_SIZE=256
REALTIME_HEARTBEAT_S=20.0

# ------------------------------------------------------------------ Repair loop (phase 29-31)
REPAIR_MAX_ITERATIONS=5
REPAIR_STALL_THRESHOLD=2

# ------------------------------------------------------------------ Frontend (Vite) — consumed by frontend/, prefix VITE_
VITE_API_BASE_URL=http://localhost:8000
