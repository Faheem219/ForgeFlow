        <mxCell id="l6" style="endArrow=none;html=1;strokeWidth=1;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1027" y="95" as="sourcePoint" /><mxPoint x="1027" y="1000" as="targetPoint" /></mxGeometry></mxCell>

        <!-- STEPS -->
        <mxCell id="s1" value="1 · upload screenshots and / or a freeform description" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=11;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105" y="130" as="sourcePoint" /><mxPoint x="460" y="130" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="s2" value="2 · REQUIREMENTS — guided form, or an AI-drafted feature list (routing model) that the user edits; never auto-saved" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=11;verticalAlign=bottom;align=left;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="175" as="sourcePoint" /><mxPoint x="105" y="175" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="s3" value="3 · DESIGN — image→UI via the pluggable DesignProvider; finalized requirements folded into the prompt" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=11;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="230" as="sourcePoint" /><mxPoint x="1027" y="230" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s3b" value="HTML / CSS → versioned design artifact; refine ×N conversationally, each round a new version" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=11;verticalAlign=bottom;align=left;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1027" y="270" as="sourcePoint" /><mxPoint x="105" y="270" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="s4" value="4 · BUILD — instantiate the fixed skeleton by deterministic copy (no tokens spent rescaffolding)" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=11;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="330" as="sourcePoint" /><mxPoint x="835" y="330" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s5" value="5 · codegen agent writes ONLY feature code through sandbox-bound tools (read/write/exec/test/commit)" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=11;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="375" as="sourcePoint" /><mxPoint x="835" y="375" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s6" value="6 · file-write events stream live into the Monaco editor; terminal and preview stream over the same WS hub" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=11;verticalAlign=bottom;align=left;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="835" y="420" as="sourcePoint" /><mxPoint x="280" y="420" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="s7" value="7 · TEST — each acceptance criterion compiled into unit + Playwright E2E tests, tagged by criterion_id" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=11;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="490" as="sourcePoint" /><mxPoint x="650" y="490" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s8" value="8 · suites execute in the sandbox → normalised per-test results" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=11;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="535" as="sourcePoint" /><mxPoint x="835" y="535" as="targetPoint" /></mxGeometry></mxCell>

        <!-- REPAIR BOX -->
        <mxCell id="rep" value="9 · BOUNDED, DIFF-AWARE SELF-HEALING REPAIR LOOP  (Fig. 3)&#10;minimal context → targeted patch → re-run · guards: regression → stall → cap → budget&#10;green ⇒ continue     ·     any guard trips ⇒ escalate to the user with a &quot;here is where I am stuck&quot; summary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="565" width="600" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="escalation surfaces failing tests + diffs tried; user guidance re-enters BUILD" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#8A5A00;fontSize=11;verticalAlign=bottom;align=left;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="670" as="sourcePoint" /><mxPoint x="105" y="670" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="s10" value="10 · DEPLOY — infra analyzer → provision DB → Render (BE) → Vercel (FE) → env wiring → health checks" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=11;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="725" as="sourcePoint" /><mxPoint x="1027" y="725" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s11" value="live URLs + topology snapshot → React Flow graph with per-node status and logs" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=11;verticalAlign=bottom;align=left;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1027" y="770" as="sourcePoint" /><mxPoint x="280" y="770" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="s12" value="11 · VALIDATE — the same Playwright suite re-pointed at the DEPLOYED URL" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=11;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="825" as="sourcePoint" /><mxPoint x="1027" y="825" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s13" value="on live failure: diagnose → repair (Fig. 3) → redeploy → re-validate" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#8A5A00;fontSize=11;verticalAlign=bottom;align=left;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1027" y="865" as="sourcePoint" /><mxPoint x="460" y="865" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="done" value="12 · LIVE, VALIDATED URL DELIVERED — proven against production, not merely against the sandbox" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E8F0E8;strokeColor=#1A6A1A;strokeWidth=3;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="105" y="900" width="875" height="50" as="geometry" />
        </mxCell>

