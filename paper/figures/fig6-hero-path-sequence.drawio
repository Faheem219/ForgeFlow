        <mxCell id="note" value="At every numbered step the user may refine conversationally, skip the stage outright, or jump to any other stage;&#10;the sequence above is the DEFAULT path, not a required one.  Only deploy ⇐ build and validate ⇐ deploy are enforced." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#333333;dashed=1;fontSize=11;fontStyle=2;" vertex="1" parent="1">
