<mxfile host="app.diagrams.net" agent="ForgeFlow" version="24.7.17">
  <diagram id="fig4-trace" name="Fig 4 - Traceability Chain">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="banner" value="criterion_id  —  the single join key that threads a user's acceptance criterion through generation, execution, failure and repair" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE3F0;strokeColor=#1A1A1A;strokeWidth=2;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1070" height="42" as="geometry" />
        </mxCell>

        <!-- 1 REQUIREMENTS -->
        <mxCell id="r" value="① RequirementSpec&#10;(structured, fill-in-the-blanks — captured by a guided form,&#10;or drafted from a freeform description by the routing model and edited by the user)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7FA;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="480" height="185" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="Feature &quot;Add a task&quot;&#10;  inputs[]                  title, due date&#10;  expected_behaviors[]      task appears in the list&#10;  acceptance_criteria[]&#10;      ▸ AC-01  an empty title is rejected&#10;      ▸ AC-02  a saved task persists after reload&#10;      ▸ AC-03  the list shows newest first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="58" y="155" width="444" height="110" as="geometry" />
        </mxCell>

        <!-- 2 TEST SUITE -->
        <mxCell id="t" value="② TestSuite  (test-generation agent, MODEL_CODEGEN)&#10;every acceptance criterion yields ≥ 1 executable test, tagged with its criterion_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7FA;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="630" y="95" width="480" height="185" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="unit — Vitest (FE) · Jest + supertest (BE)&#10;   ▸ AC-01 → rejects empty title            [unit]&#10;   ▸ AC-03 → orders by createdAt desc        [unit]&#10;&#10;E2E — Playwright against the sandbox preview&#10;   ▸ AC-02 → create → reload → still present [e2e]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="648" y="155" width="444" height="110" as="geometry" />
        </mxCell>

        <!-- 3 TEST RUN -->
        <mxCell id="run" value="③ TestRun — executed inside the project sandbox; JUnit / JSON output normalised to&#10;per-test { status, assertion, stack, files_referenced, criterion_id }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7FA;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="330" width="490" height="130" as="geometry" />
        </mxCell>
        <mxCell id="run1" value="AC-01  PASS        AC-03  PASS&#10;AC-02  FAIL   expected 1 row, received 0&#10;              at tasks.e2e.spec.ts:24&#10;              → api/tasks.ts, models/Task.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="348" y="385" width="454" height="60" as="geometry" />
        </mxCell>

        <!-- 4 REPAIR CONTEXT -->
        <mxCell id="rc" value="④ RepairContext (Fig. 3, step ①)&#10;the failing criterion_id is joined BACK to its requirement text, so the agent&#10;patches against what the user actually asked for — not against the test alone" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF1F8;strokeColor=#1A1A1A;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="510" width="490" height="135" as="geometry" />
        </mxCell>
        <mxCell id="rc1" value="failing test        AC-02 e2e spec + assertion + stack&#10;target files        api/tasks.ts, models/Task.ts   (only these)&#10;diff                since the `last-passing` git ref&#10;requirement         &quot;a saved task persists after reload&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="348" y="565" width="454" height="66" as="geometry" />
        </mxCell>

        <!-- 5 REPAIR ATTEMPT -->
        <mxCell id="ra" value="⑤ RepairAttempt&#10;patch → commit&#10;→ re-run&#10;→ outcome ∈&#10;fixed | no_progress&#10;| regressed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="510" width="230" height="135" as="geometry" />
        </mxCell>

        <!-- Backward traceability panel -->
        <mxCell id="back" value="WHAT THE CHAIN BUYS&#10;&#10;forward   requirement → test → result&#10;          every criterion is provably&#10;          exercised by at least one test&#10;&#10;backward  failure → criterion → feature&#10;          a red test names the user-level&#10;          promise it broke, in the user's&#10;          own words&#10;&#10;repair    the agent is given the acceptance&#10;          text, so it fixes the behaviour&#10;          rather than merely satisfying the&#10;          assertion&#10;&#10;coverage  criteria with no passing test are&#10;          reported as unmet — not as&#10;          &quot;tests passed&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#333333;strokeWidth=2;dashed=1;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="255" height="315" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Non-linearity is preserved: when no RequirementSpec exists the test-generation stage warns and offers to capture one or to infer a minimal set —&#10;requirements are a soft nudge in the UI, never a gate (the only hard prerequisites in ForgeFlow are deploy ⇐ build and validate ⇐ deploy)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;fontStyle=2;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="675" width="1070" height="50" as="geometry" />
        </mxCell>

        <!-- EDGES -->
        <mxCell id="e1" value="compiles into" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=classic;strokeColor=#000000;fontSize=11;" edge="1" parent="1" source="r" target="t"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="executes as" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=classic;strokeColor=#000000;fontSize=11;" edge="1" parent="1" source="t" target="run"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="failures feed" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=classic;strokeColor=#000000;fontSize=11;" edge="1" parent="1" source="run" target="rc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=classic;strokeColor=#000000;" edge="1" parent="1" source="rc" target="ra"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="re-run (bounded — Fig. 3)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=classic;strokeColor=#000000;dashed=1;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ra" target="run">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="995" y="395" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e6" value="criterion_id joins back to the requirement" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;endArrow=classic;strokeColor=#B00000;dashed=1;fontSize=11;fontColor=#B00000;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rc" target="r">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="578" /><mxPoint x="310" y="300" /><mxPoint x="160" y="300" /></Array></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
