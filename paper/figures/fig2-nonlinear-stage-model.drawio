        <!-- Six stages -->
        <mxCell id="s1" value="REQUIREMENTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1" vertex="1" parent="1">
