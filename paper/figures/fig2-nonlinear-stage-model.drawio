          <mxGeometry x="360" y="210" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="BUILD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="210" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="TEST + REPAIR&#10;(Fig. 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;strokeWidth=3;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="680" y="210" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="DEPLOY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="840" y="210" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="VALIDATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1000" y="210" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- Forward edges -->
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=classic;strokeColor=#000000;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=classic;strokeColor=#000000;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=classic;strokeColor=#000000;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- The only two enforced orderings -->
        <mxCell id="f4" value="deploy ⇐ build" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;endArrow=classic;strokeColor=#B00000;fontColor=#B00000;fontSize=10;fontStyle=1;verticalAlign=bottom;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="validate ⇐ deploy" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;endArrow=classic;strokeColor=#B00000;fontColor=#B00000;fontSize=10;fontStyle=1;verticalAlign=bottom;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Optional: skip -->
