        <mxCell id="cond" value="CONDUCTOR — owns transition legality" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE3F0;strokeColor=#1A1A1A;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="30" width="420" height="40" as="geometry" />
        </mxCell>

        <!-- Entry -->
        <mxCell id="entry" value="USER&#10;enters at&#10;ANY stage" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="120" height="80" as="geometry" />
