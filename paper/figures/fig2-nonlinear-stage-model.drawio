<mxfile host="app.diagrams.net" agent="ForgeFlow" version="24.7.17">
  <diagram id="fig2-stages" name="Fig 2 - Non-linear Stage Model">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
