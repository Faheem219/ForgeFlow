        <mxCell id="d4" value="health-checked" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=classic;strokeColor=#000000;fontSize=10;" edge="1" parent="1" source="topo" target="val"><mxGeometry relative="1" as="geometry" /></mxCell>
