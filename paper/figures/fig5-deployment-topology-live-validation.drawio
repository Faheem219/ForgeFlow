        </mxCell>
        <mxCell id="cr2" value="BRING-YOUR-OWN&#10;encrypted at rest, decrypted at call time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="584" y="238" width="260" height="46" as="geometry" />
        </mxCell>

        <!-- 3. ordered deploy topology -->
        <mxCell id="topo" value="③  Ordered deploy — provision DB, then BE, then FE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="170" y="330" width="810" height="136" as="geometry" />
