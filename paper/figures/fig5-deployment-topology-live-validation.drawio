        <mxCell id="db" value="DATABASE&#10;MongoDB Atlas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="190" y="382" width="220" height="62" as="geometry" />
