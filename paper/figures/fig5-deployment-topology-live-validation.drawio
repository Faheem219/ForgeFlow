        <!-- 5. live failure repair -->
        <mxCell id="rep" value="⑤  Live-failure repair — bounded loop (Fig. 3) → redeploy → re-validate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF0F0;strokeColor=#B00000;strokeWidth=3;fontSize=11;fontStyle=1" vertex="1" parent="1">
