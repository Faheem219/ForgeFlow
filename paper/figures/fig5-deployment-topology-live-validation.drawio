        <!-- 4. live validation -->
        <mxCell id="val" value="④  Live validation — the same Playwright suite,&#10;re-pointed at the deployed URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1" vertex="1" parent="1">
