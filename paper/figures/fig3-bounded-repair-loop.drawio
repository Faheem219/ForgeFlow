        <mxCell id="ed6" value="NO" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=classic;strokeColor=#000000;fontSize=10;fontStyle=1" edge="1" parent="1" source="dec" target="guards"><mxGeometry relative="1" as="geometry" /></mxCell>
