  <diagram id="fig3-repair" name="Fig 3 - Bounded Diff-Aware Repair Loop">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
