        <mxCell id="caps" value="hard caps&#10;24k total · 8k file · 8k diff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#666666;dashed=1;fontSize=10;" vertex="1" parent="1">
