        <mxCell id="guards" value="④  Termination guards — evaluated in precedence order" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5E9D8;strokeColor=#8A5A00;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="190" y="530" width="770" height="118" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="G1&#10;REGRESSION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A5A00;strokeWidth=2;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="206" y="574" width="174" height="56" as="geometry" />
