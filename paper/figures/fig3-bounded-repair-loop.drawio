        <mxCell id="g4" value="G4&#10;BUDGET / CANCEL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A5A00;strokeWidth=2;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="776" y="574" width="174" height="56" as="geometry" />
        </mxCell>

        <!-- 5. escalation -->
        <mxCell id="esc" value="⑤  Escalate to the user — a terminal state, not an error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF0F0;strokeColor=#B00000;strokeWidth=3;fontSize=11;fontStyle=1" vertex="1" parent="1">
