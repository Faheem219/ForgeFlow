        <!-- 2. patch -->
        <mxCell id="patch" value="②  Targeted patch  (MODEL_CODEGEN)  →  commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="340" y="218" width="470" height="52" as="geometry" />
        </mxCell>

        <!-- 3. re-run -->
        <mxCell id="rerun" value="③  Re-run affected suite, then the full suite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="340" y="310" width="470" height="52" as="geometry" />
        </mxCell>

        <!-- decision -->
        <mxCell id="dec" value="all green?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="475" y="402" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- success -->
        <mxCell id="fixed" value="Fixed&#10;last-passing ref advances" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0E8;strokeColor=#1A6A1A;strokeWidth=2;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="850" y="410" width="230" height="64" as="geometry" />
