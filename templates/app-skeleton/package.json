{
  "name": "forgeflow-app",
  "version": "0.1.0",
  "private": true,
  "description": "ForgeFlow generated-app skeleton — fixed MERN-TS stack (React+Vite+TS+Tailwind / Express+TS+Mongoose). The codegen agent fills this in; it never rescaffolds it.",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:unit": "pnpm -r --workspace-concurrency=1 run test:unit",
    "test:e2e": "pnpm --filter frontend run test:e2e"
  }
}
