# ForgeFlow generated-app environment contract.
#
# These variables are INJECTED by ForgeFlow at run time — you rarely set them by hand:
#   - preview (phase-15) injects them into the sandbox dev servers
#   - deploy  (phase-37) injects them into Vercel (FE) and Render (BE)
#
# Copy per-package: frontend reads VITE_*, backend reads the rest.

# --- Backend (Express) ---
# Port the API listens on. Preview/Render inject this; defaults to 3001 locally.
PORT=3001
# Mongo connection string for THIS project's isolated database (phase-36 provisions it).
MONGODB_URI=mongodb://localhost:27017/forgeflow_app
# development | production
NODE_ENV=development

# --- Frontend (Vite) ---
# Absolute base URL of the backend API. Preview/deploy set this to the live BE URL.
VITE_API_BASE_URL=http://localhost:3001
# Comma-separated hostnames the dev server may be reached through (vite.config reads it into
# `server.allowedHosts`). Preview injects the proxied preview hostnames; Vite answers 403 to any
# Host it does not recognise. Only affects `pnpm dev` — irrelevant for a built/deployed app.
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
