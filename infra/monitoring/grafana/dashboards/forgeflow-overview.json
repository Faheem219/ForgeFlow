{
  "uid": "forgeflow-overview",
  "title": "ForgeFlow — Service Overview",
  "description": "Uptime, latency and error rate for the ForgeFlow control plane, plus the host it runs on. Top row is the at-a-glance health check; rows below are the golden signals and then the VM itself.",
  "tags": ["forgeflow", "devops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
        "query": "label_values(forgeflow_http_requests_total, path)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Health at a glance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 1,
      "type": "stat",
      "title": "Uptime (24h)",
      "description": "Share of blackbox probes that succeeded over 24h. This probes the PUBLIC URL, so it covers DNS, TLS, nginx and the app — not just the process.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(probe_success{probe=\"public-health\"}[24h]) * 100",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Current status",
      "description": "The most recent public probe. 1 = reachable and /health returned status:ok.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{probe=\"public-health\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        },
        "overrides": []
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Error rate (5m)",
      "description": "5xx responses as a share of all responses. A ratio, not a count — an absolute threshold would make a busy period look like an outage.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(forgeflow_http_requests_total{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(forgeflow_http_requests_total[5m])) or vector(0), 0.001)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency (5m)",
      "description": "95th percentile response time, computed from the histogram buckets — an average would hide exactly the tail this is meant to surface.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 15, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(forgeflow_http_request_duration_seconds_bucket[5m])))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Version",
      "description": "From forgeflow_build_info. If this shows more than one value, a rollout is half-finished.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "forgeflow_build_info",
          "instant": true,
          "legendFormat": "{{version}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },

    {
      "type": "row",
      "title": "Golden signals",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency percentiles",
      "description": "p50 / p90 / p95 / p99 on ONE axis — they share a unit, so they belong in one panel. Note this is deliberately not combined with throughput: two different units on two y-axes is the single most misread chart there is.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(forgeflow_http_request_duration_seconds_bucket{path=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le) (rate(forgeflow_http_request_duration_seconds_bucket{path=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(forgeflow_http_request_duration_seconds_bucket{path=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(forgeflow_http_request_duration_seconds_bucket{path=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisGridShow": true
          }
        },
        "overrides": []
      }
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate by status class",
      "description": "Throughput split by status class. Stacked, because the parts sum to a meaningful whole (total requests).",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(forgeflow_http_requests_total{path=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" },
            "axisGridShow": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "5.." },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "4.." },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "2.." },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      }
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "Error ratio",
      "description": "5xx as a fraction of all requests, with the 5% alert threshold drawn in.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(forgeflow_http_requests_total{status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(forgeflow_http_requests_total[$__rate_interval])) or vector(0), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 9,
      "type": "timeseries",
      "title": "Slowest routes (p95)",
      "description": "p95 per route template. Because the path label is the ROUTE TEMPLATE, this stays a small, stable set however many projects exist.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, histogram_quantile(0.95, sum by (le, path) (rate(forgeflow_http_request_duration_seconds_bucket[$__rate_interval]))))",
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests in flight",
      "description": "Concurrency. A number that climbs and never comes back down means requests are piling up — usually the first visible sign of a stall.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "forgeflow_http_requests_in_flight", "legendFormat": "in flight" }
      ],
      "options": {
        "legend": { "showLegend": false },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" }
        },
        "overrides": []
      }
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "Unhandled exceptions",
      "description": "Exceptions that escaped a route handler — these bypassed the error taxonomy entirely.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path) (increase(forgeflow_http_unhandled_exceptions_total[$__rate_interval]))",
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "showPoints": "never" }
        },
        "overrides": []
      }
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "Probe duration (public URL)",
      "description": "How long the full public round trip takes, broken down by phase. A DNS or TLS phase that grows is invisible to any in-process metric.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_duration_seconds{probe=\"public-health\"}",
          "legendFormat": "{{phase}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      }
    },

    {
      "type": "row",
      "title": "The VM",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false
    },

    {
      "id": 13,
      "type": "timeseries",
      "title": "CPU utilisation",
      "description": "Derived from idle time, which is the only mode guaranteed present on every kernel.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 32 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])) * 100)",
          "legendFormat": "cpu"
        }
      ],
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 14,
      "type": "timeseries",
      "title": "Memory used",
      "description": "Uses MemAvailable, not MemFree: page cache is reclaimable, so MemFree makes a perfectly healthy Linux box look permanently full.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 32 },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "memory"
        }
      ],
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 15,
      "type": "gauge",
      "title": "Root disk used",
      "description": "The most likely way this VM dies: images, sandbox volumes, Mongo data and logs all share one small boot volume.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 32 },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})) * 100",
          "instant": true,
          "legendFormat": "/"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 16,
      "type": "timeseries",
      "title": "Memory by container",
      "description": "Per-container working set. This is how a runaway sandbox becomes identifiable rather than just unexplained host load.",
      "datasource": { "type": "prometheus", "uid": "forgeflow-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 39 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (name) (container_memory_working_set_bytes{name!=\"\"}))",
          "legendFormat": "{{name}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["max", "mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      }
    }
  ]
}
