{{ ansible_managed | comment }}
# ForgeFlow production environment — generated by Ansible. DO NOT EDIT BY HAND:
# `ansible-playbook site.yml` rewrites this file (it keeps a .bak alongside).
#
# Every key here is documented in the repo's .env.example and read through the layered resolver in
# backend/app/core/config.py (precedence: admin panel DB > env > code default). Anything not set
# here falls back to the code default, and almost everything is editable at runtime from /admin.
#
# Comment style matters: comments live on their OWN lines, never trailing a KEY=value. Both
# consumers require it — python-dotenv strips inline comments, but docker-compose's `env_file`
# keeps `# comment` after a *blank* value as the literal value.

# ------------------------------------------------------------------ Core
FORGEFLOW_ENV=prod
SECRET_KEY={{ forgeflow_secret_key }}
# Encrypts the credential vault. Rotating this permanently invalidates every stored provider
# token — they cannot be decrypted under a new key. Ansible generates it once and then reads it
# back on every subsequent run precisely so that never happens by accident. Back it up.
FERNET_KEY={{ forgeflow_fernet_key }}
APP_VERSION=0.1.0
# The Vercel frontend origin. Not "*": the app enables credentialed CORS whenever origins != ["*"],
# and every browser rejects a wildcard with credentials.
CORS_ORIGINS={{ forgeflow_cors_origins }}
LOG_LEVEL=INFO
LOG_JSON=true

# ------------------------------------------------------------------ Metrics (devops step 4)
# Scraped by the Prometheus in infra/monitoring. Moving the path means changing both.
METRICS_ENABLED=true
METRICS_PATH=/metrics

# ------------------------------------------------------------------ Deployment wiring
# The image CD deploys. Rewritten per-release by .github/workflows/cd.yml with an immutable SHA
# tag — which is what makes rollback meaningful, since `latest` after a bad deploy points at the
# broken build.
FORGEFLOW_IMAGE={{ forgeflow_image }}
# Host loopback port nginx proxies to.
FORGEFLOW_API_PORT={{ forgeflow_api_port }}
# The host's docker group id, discovered by the docker role. The api container runs as uid 10001
# and needs this in its supplementary groups to use /var/run/docker.sock. It differs per image
# (988/999/1001), so it is read from the host rather than assumed.
DOCKER_GID={{ docker_gid }}
{% if forgeflow_preview_domain %}
PREVIEW_BASE_DOMAIN={{ forgeflow_preview_domain }}
{% else %}
# No wildcard DNS configured — preview URLs are not publicly exposed. Everything else works.
PREVIEW_BASE_DOMAIN=preview.localhost
{% endif %}

# ------------------------------------------------------------------ Database
# Service names on the compose network, not localhost: a sandbox has no route to the host, so a
# loopback connection string can never work from inside one.
MONGODB_URI=mongodb://mongo:27017
FORGEFLOW_META_DB=forgeflow_meta
# The DB handed to DEPLOYED generated apps — they run on Vercel, so it must be publicly reachable
# (Atlas). A deploy refuses to start with a docker service name here. Set vault_app_db_cluster_uri,
# or override it in /admin (the admin layer wins over this file).
{% if vault_app_db_cluster_uri is defined %}
APP_DB_CLUSTER_URI={{ vault_app_db_cluster_uri }}
{% else %}
APP_DB_CLUSTER_URI=mongodb://forgeflow-appdb:27017
{% endif %}
# The same role as seen from a SANDBOX (preview + tests). Sandboxes have no internet, so Atlas is
# unreachable from there; the compose appdb service is what they can reach.
APP_DB_SANDBOX_URI=mongodb://forgeflow-appdb:27017

# ------------------------------------------------------------------ Sandbox
SANDBOX_IMAGE=forgeflow-sandbox:latest
PREVIEW_NETWORK_NAME=forgeflow-preview

# ------------------------------------------------------------------ Provider credentials
# Left blank deliberately. Set them from the /admin dashboard, where they are Fernet-encrypted at
# rest and never readable again — rather than sitting in plaintext in a file on disk. The admin
# layer overrides env, so a value set there wins without a redeploy.
{% if vault_anthropic_api_key is defined %}
ANTHROPIC_API_KEY={{ vault_anthropic_api_key }}
{% else %}
ANTHROPIC_API_KEY=
{% endif %}
LLM_PROVIDER=anthropic
MODEL_CODEGEN=claude-sonnet-5
MODEL_ROUTING=claude-haiku-4-5-20251001
MODEL_CLASSIFY=

# Seed an admin account on first `make seed` so you can reach /admin to enter the keys above.
{% if vault_seed_admin_email is defined %}
SEED_ADMIN_EMAIL={{ vault_seed_admin_email }}
SEED_ADMIN_PASSWORD={{ vault_seed_admin_password }}
{% else %}
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
{% endif %}
